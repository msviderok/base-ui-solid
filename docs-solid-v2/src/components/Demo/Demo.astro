---
import { DemoShell } from './DemoShell';
interface Props {
  path: string;
  class?: string;
  defaultOpen?: boolean;
  compact?: boolean;
  showExtraPlaygroundLink?: boolean;
}
const {
  path,
  class: className,
  defaultOpen = false,
  compact = false,
  showExtraPlaygroundLink = false,
} = Astro.props;
---
<div class={`mt-5 mb-6 ${className ?? ''}`}>
  <DemoShell
    path={path}
    compact={compact}
    defaultOpen={defaultOpen}
    showExtraPlaygroundLink={showExtraPlaygroundLink}
    client:load
  />
</div>
