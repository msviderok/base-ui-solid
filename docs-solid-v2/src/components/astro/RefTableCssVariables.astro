---
import CssVariablesTable from '@/components/solid/ReferenceTable/CssVariablesReferenceTable';
import type { CssVariableDef } from '@/components/solid/ReferenceTable/types';

export interface Props {
  data: Record<string, CssVariableDef>;
  name?: string;
  class?: string;
}

const { data, name, class: className } = Astro.props;
---

<CssVariablesTable
  class={`mt-5 mb-6 ${className || ''}`.trim()}
  name={name}
  data={data}
  client:only="solid-js"
/>
