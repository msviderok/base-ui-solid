---
import { MarkdownIcon } from '@/components/solid/icons/MarkdownIcon';

const pathname = Astro.url.pathname;
---

<a
  href={`${pathname}.md`}
  class="shrink-0"
  aria-label="View markdown source"
  rel="alternate"
  type="text/markdown"
>
  <span class="MarkdownLink">
    <MarkdownIcon />
    View as Markdown
  </span>
</a>
