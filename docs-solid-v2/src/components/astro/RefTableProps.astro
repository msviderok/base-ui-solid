---
import ReferenceAccordion from '@/components/solid/ReferenceTable/ReferenceAccordion';
import type { PropDef } from '@/components/solid/ReferenceTable/types';

export interface Props {
  data: Record<string, PropDef>;
  name: string;
  class?: string;
  renameFrom?: string;
  renameTo?: string;
}

const { data, name, class: className, renameFrom, renameTo } = Astro.props;
---

<ReferenceAccordion
  class={className}
  name={name}
  data={data}
  renameFrom={renameFrom}
  renameTo={renameTo}
  client:only="solid-js"
/>
