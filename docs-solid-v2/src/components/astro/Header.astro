---
import { buildNav, type NavSection } from '@/lib/buildNav';
import { MobileNav } from '@/components/solid/MobileNav';
import { Logo } from '@/components/solid/Logo';

const nav: NavSection[] = await buildNav();
---

<header class="Header">
  <div class="HeaderInner">
    <a href="/" class="HeaderLogoLink"> <Logo aria-label="Base UI" /> </a>
    <div class="flex gap-6 max-show-side-nav:hidden">
      <a
        class="HeaderLink"
        href="https://www.npmjs.com/package/@msviderok/base-ui-solid"
        rel="noopener"
        target="_blank"
      >
        npm
      </a>
      <a class="HeaderLink" href="https://github.com/mui/base-ui" rel="noopener" target="_blank">
        GitHub
      </a>
    </div>
    <div class="flex items-center gap-2 show-side-nav:hidden">
      <MobileNav nav={nav} client:load />
    </div>
  </div>
</header>
