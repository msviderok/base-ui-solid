---
import ReturnValueTable from '@/components/solid/ReferenceTable/ReturnValueReferenceTable';
import type { PropDef } from '@/components/solid/ReferenceTable/types';

export interface Props {
  data: Record<string, PropDef>;
  name?: string;
  class?: string;
}

const { data, name, class: className } = Astro.props;
---

<ReturnValueTable
  class={`mt-5 mb-6 ${className || ''}`.trim()}
  name={name}
  data={data}
  client:only="solid-js"
/>
