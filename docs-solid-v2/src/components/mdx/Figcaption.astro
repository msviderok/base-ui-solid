---
const props = Astro.props;
const isCodeTitle = 'data-rehype-pretty-code-title' in props;
---

{isCodeTitle ? (
    <div class="CodeBlockPanel" {...props}>
      <div class="CodeBlockPanelTitle">
        <slot />
      </div>
    </div>
  ) : (
    <figcaption {...props}>
      <slot />
    </figcaption>
  )}
