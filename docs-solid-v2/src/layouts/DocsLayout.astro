---
import { ClientRouter } from 'astro:transitions';
import SideNav from '../components/SideNav';
import Header from '../components/Header.astro';
import { buildNav } from '../utils/buildNav';
import { QuickNav } from '../components/QuickNav';
import '../styles/styles.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · Base UI` : 'Base UI';
const pathname = Astro.url.pathname;
const nav = await buildNav();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    <link rel="preload" href="/fonts/regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg" />
    <link rel="icon" href="/static/favicon.ico" sizes="32x32" />
    <ClientRouter />
  </head>
  <body>
    <div class="RootLayout">
      <div class="RootLayoutContainer">
        <div class="RootLayoutContent">
          <div class="ContentLayoutRoot">
            <Header />
            <nav aria-label="Main navigation" class="SideNavRoot">
              <SideNav pathname={pathname} sitemap={nav} client:load />
            </nav>
            <main class="ContentLayoutMain" id="main-content">
              <QuickNav client:load>
                <slot />
              </QuickNav>
            </main>
          </div>
        </div>
        <span class="RootLayoutFooter"></span>
      </div>
    </div>
    <script>
      document.addEventListener('astro:before-preparation', () => {
        const anchor = document.activeElement?.closest?.('a') ?? document.querySelector('a:hover');
        if (!anchor) return;

        const spinner = document.createElement('span');
        spinner.className = 'NavSpinner';
        anchor.appendChild(spinner);

        // Clean up after navigation completes (or fails)
        const cleanup = () => spinner.remove();
        document.addEventListener('astro:after-swap', cleanup, { once: true });
        // Fallback: remove after 5s in case navigation is cancelled
        setTimeout(cleanup, 5000);
      });
    </script>
  </body>
</html>
