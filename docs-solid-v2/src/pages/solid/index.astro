---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { mdxComponents } from '../../mdx-components';

const entries = await getCollection('solid');
const entry = entries.find((candidate) => candidate.id.replace(/\.mdx$/, '') === 'index');

if (!entry) {
  throw new Error('Missing solid docs index page.');
}

const { Content } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <Content components={mdxComponents as any} />
</DocsLayout>
